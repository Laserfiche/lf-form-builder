{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "allowJs": true,
    "baseUrl": "./src",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "lib"
  },
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../core"
    }
  ],
  "include": [
    "src",
    "vite.config.ts",
    "laserfiche.config.json"
  ]
}