@import '@lfz/lf-form-builder/css/form-theme.lfless';


.renderer-preview-only({
  // Field with autofill button
  .stripe-checkout {
    fl-field-label {
      display: none;
    }

    .cf-field > *:not(.auto-fill-btn-container) {
      display: none;
    }

    .auto-fill-btn-container>button {
      font-size: 0;

      &::after {
        content: 'Checkout';
        font-size: 16px;
      }
    }
  }

  #stripe-checkout-iframe {
    border: none;
    width: 100%;
    height: 70vh;
  }

  .cf-field {
    border: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .stripe-checkout-frame {
    border: 0;
    background: transparent;
    padding: 0;
    margin: 0;
  }

  .stripe-checkout-iframe,
  #stripe-checkout-iframe {
    display: block;
    border: 0 !important;
    outline: 0;
    background: transparent;
    box-shadow: none;
  }
});