{
  "name": "@lfz/form-builder-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "watch": "tsc && vite build --mode development --watch",
    "build": "tsc && vite build --mode production",
    "build:dev": "tsc && vite build --mode development",
    "make-cert": "mkdir -p certs && openssl req -x509 -newkey rsa:4096 -keyout certs/localhost-key.pem -out certs/localhost-cert.pem -days 365 -nodes -subj '/CN=localhost' -addext \"subjectAltName = DNS:localhost\"",
    "trust-cert": "openssl pkcs12 -export -out certs/localhost.pfx -inkey certs/localhost-key.pem -in certs/localhost-cert.pem",
    "dev": "run-p watch serve",
    "sdev": "run-p watch sserve",
    "serve": "serve -l 3000 --cors --no-clipboard",
    "sserve": "serve -l 3000 --no-clipboard --ssl-cert ./certs/localhost-cert.pem --ssl-key ./certs/localhost-key.pem"
  },
  "devDependencies": {
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^25.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.6",
    "typescript": "^5.5.3",
    "vite": "^8.0.2",
    "vite-plugin-mkcert": "^1.17.10"
  },
  "dependencies": {
    "@googlemaps/addressvalidation": "^3.2.1",
    "@lfz/lf-form-builder": "*",
    "@lfz/lf-form-types": "*"
  }
}
