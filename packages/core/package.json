{
  "name": "@lf/lf-form-builder",
  "version": "0.1.0",
  "description": "Utilities, components, and Vite plugins for building custom Laserfiche Forms.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laserfiche/lf-form-builder.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Laserfiche/lf-form-builder#readme",
  "bugs": {
    "url": "https://github.com/Laserfiche/lf-form-builder/issues"
  },
  "keywords": [
    "laserfiche",
    "forms",
    "vite-plugin",
    "lfless",
    "form-builder"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/plugins/*.js",
      "types": "./dist/plugins/*.d.ts"
    },
    "./css/*": "./src/css/*"
  },
  "files": [
    "dist",
    "src/css"
  ],
  "scripts": {
    "compile": "vite build --config vite.config.lib.ts",
    "build": "vite build --config vite.config.lib.ts --mode development",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/less": "^3.0.8",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.8.9",
    "less": "^4.5.1",
    "typescript": "^5.5.3",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@googlemaps/addressvalidation": "^3.2.1",
    "@lf/lf-form-types": "*",
    "@laserfiche/lf-repository-api-client-v2": "^1.0.9"
  }
}
