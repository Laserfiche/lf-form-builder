{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@components/*": ["./src/components/*"],
      "@css/*": ["./src/css/*"],
      "@lfz/lf-form-types": ["../types/lib/index.d.ts"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "dist",
    "noFallthroughCasesInSwitch": true
  },
  "references": [
    { "path": "../types" }
  ],
  "include": ["src"]
}
