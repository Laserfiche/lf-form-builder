span.star:hover {
  color: white !important;
  font-size: 1.74rem;
}
span.star.selected {
  color: goldenrod;
}
span.star {
  font-size: 1.5rem;
  transition: all 0.25s ease-in-out;
  -webkit-text-stroke: 0.5px black;
}
div.star-container {
  height: 1.75rem;
  display: flex;
  align-items: center;
}
@media screen and (max-width: 600px) {
  .form-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
}
@media screen and (min-width: 600px) {
  .fl-table.fl-component table {
    table-layout: fixed;
  }
  .small-col {
    width: 15% !important;
  }
  .form-info {
    display: flex;
    flex: 1;
    align-items: center;
  }
  .form-info > h1 {
    flex: 1;
  }
  .form-info > * {
    margin: 0 !important;
  }
}
.star-component .cf-field > div {
  display: none;
}
.star-component label.cf-helptext {
  margin: auto 8px;
}