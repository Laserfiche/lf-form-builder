.modal-open {
  overflow: hidden;
}

.modal-open .modal {
  overflow-x: hidden;
  overflow-y: auto;
}

.pd-canvas-container & {
  .lf-modal {
    display: block;
    border: 1px dashed gray;
    border-radius: var(--simple-input-border-radius);
  }

  .lf-modal::after {
    content: 'modal';
    position: absolute;
    right: 0;
    top: 0;
    background: lightgray;
    border-radius: 0.25rem;
    padding: 0.25rem;
    margin: 2px;
  }
}

.lf-modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100%;
}

.lf-modal-backdrop {
  background-color: rgba(0, 0, 0, .2);
  backdrop-filter: blur(5px);
}

.lf-modal-backdrop-position {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1049;
}

.lf-modal {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1050;
  display: none;
  width: 100%;
  height: 100%;
  overflow: hidden;
  outline: 0;
}

.lf-modal>fl-section {
  position: relative;
  width: auto;
  margin: 0.5rem;
  width: 500px;
  pointer-events: none;
}

.lf-modal.fade>fl-section {
  transition: -webkit-transform 0.3s ease-out;
  transition: transform 0.3s ease-out;
  transition: transform 0.3s ease-out, -webkit-transform 0.3s ease-out;
  -webkit-transform: translate(0, -50px);
  transform: translate(0, -50px);
}

@media (prefers-reduced-motion: reduce) {
  .lf-modal.fade>fl-section {
    transition: none;
  }
}

.lf-modal.show>fl-section {
  -webkit-transform: none;
  transform: none;
}

.lf-modal.lf-modal-static>fl-section {
  -webkit-transform: scale(1.02);
  transform: scale(1.02);
}

.lf-modal-dialog-scrollable>fl-section {
  display: -ms-flexbox;
  display: flex;
  max-height: calc(100% - 1rem);
}

.lf-modal-dialog-scrollable>fl-section>div {
  max-height: calc(100vh - 1rem);
  overflow: hidden;
}

.lf-modal-dialog-scrollable .section-title,
.lf-modal-dialog-scrollable>fl-section>div>fl-helptext {
  -ms-flex-negative: 0;
  flex-shrink: 0;
}

.fl-modal-dialog-scrollable>fl-section>div>.pane {
  overflow-y: auto;
}

.lf-modal-dialog-centered>fl-section {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  min-height: calc(100% - 1rem);
}

.modal-dialog-centered>fl-section::before {
  display: block;
  height: calc(100vh - 1rem);
  height: -webkit-min-content;
  height: -moz-min-content;
  height: min-content;
  content: "";
}

.lf-modal-dialog-centered.lf-modal-dialog-scrollable>fl-section {
  -ms-flex-direction: column;
  flex-direction: column;
  -ms-flex-pack: center;
  justify-content: center;
  height: 100%;
}

.lf-modal-dialog-centered.lf-modal-dialog-scrollable>fl-section>div {
  max-height: none;
}

.lf-modal-dialog-centered.lf-modal-dialog-scrollable::before {
  content: none;
}

.lf-modal>fl-section>div {
  position: relative;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-direction: column;
  flex-direction: column;
  width: 100%;
  pointer-events: auto;
  background-color: #fff;
  background-clip: padding-box;
  border: 1px solid rgba(0, 0, 0, 0.2);
  border-radius: 0.3rem;
  outline: 0;
}

.lf-modal.backdrop {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1040;
  width: 100vw;
  height: 100vh;
  background-color: #000;
}

.lf-modal.backdrop.fade {
  opacity: 0;
}

.lf-modal.backdrop.show {
  opacity: 0.5;
}

.lf-modal>fl-section>div>.section-title {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: start;
  align-items: flex-start;
  -ms-flex-pack: justify;
  justify-content: space-between;
  padding: 1rem 1rem;
  border-bottom: 1px solid #dee2e6;
  border-top-left-radius: calc(0.3rem - 1px);
  border-top-right-radius: calc(0.3rem - 1px);
}

.lf-modal>fl-section>div>.section-title .close {
  padding: 1rem 1rem;
  margin: -1rem -1rem -1rem auto;
}

.lf-modal>fl-section>div>.section-title .modal-title {
  margin-bottom: 0;
  line-height: 1.5;
}

.lf-modal>fl-section>div>.pane {
  position: relative;
  -ms-flex: 1 1 auto;
  flex: 1 1 auto;
  padding: 1rem;
}

.lf-modal>fl-section>div>fl-helptext {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  -ms-flex-align: center;
  align-items: center;
  -ms-flex-pack: end;
  justify-content: flex-end;
  border-top: 1px solid #dee2e6;
  border-bottom-right-radius: calc(0.3rem - 1px);
  border-bottom-left-radius: calc(0.3rem - 1px);
}

.lf-modal>fl-section>div>fl-helptext label {
  padding-right: 5px;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-wrap: wrap;
  flex-wrap: wrap;
  -ms-flex-align: center;
  align-items: center;
  -ms-flex-pack: end;
  justify-content: flex-end;
  pointer-events: none;
  gap: 8px;
  padding: 5px 20px 5px 5px;
}

.lf-modal>fl-section>div>fl-helptext>label button {
  pointer-events: all;
}

.lf-modal>fl-section>div>fl-helptext>* {
  margin: 0.25rem;
}

.modal-scrollbar-measure {
  position: absolute;
  top: -9999px;
  width: 50px;
  height: 50px;
  overflow: scroll;
}

@media (min-width: 576px) {
  .lf-modal-dialog>fl-section {
    width: 500px;
    margin: 1.75rem auto;
  }

  .lf-modal-dialog-scrollable>fl-section {
    max-height: calc(100% - 3.5rem);
  }

  .lf-modal-dialog-scrollable>fl-section>div {
    max-height: calc(100vh - 3.5rem);
  }

  .lf-modal-dialog-centered>fl-section {
    min-height: calc(100% - 3.5rem);
  }

  .lf-modal-dialog-centered>fl-section::before {
    height: calc(100vh - 3.5rem);
    height: -webkit-min-content;
    height: -moz-min-content;
    height: min-content;
  }

  .lf-modal-sm>fl-section {
    width: 300px;
  }

  .lf-modal-full>fl-section {
    height: calc(100vh - 3.5rem);
    width: calc(100% - 1rem);
  }
}

@media (min-width: 992px) {

  .lf-modal-lg>fl-section,
  .lf-modal-xl>fl-section {
    width: 800px;
  }
}

@media (min-width: 1200px) {
  .lf-modal-xl>fl-section {
    width: 1140px;
  }
}

.fade {
  transition: opacity 0.15s linear;
}

@media (prefers-reduced-motion: reduce) {
  .fade {
    transition: none;
  }
}

.fade:not(.show) {
  opacity: 0;
}