@import "./_variables.lfless";

.linkify .fl-component {
  &.disabled,
  &.readonly {
    fl-helptext:last-child {
      display: block;
      height: 0px;
    }

    .full-w-html {
      position: absolute;
      font-size: 14px;
      top: 16px;
      left: 12px;
      width: 100%;
      height: 38px;
      display: flex;
      align-items: center;
    }

    input,
    .submission-view {
      visibility: hidden;
    }
  }
}