# ── Stripe (page 3) ───────────────────────────────────────────────────────────
# Publishable key from https://dashboard.stripe.com/apikeys
# Format: pk_test_... (test) or pk_live_... (production)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# ── Braintree (page 4) ────────────────────────────────────────────────────────
# Tokenization key from https://sandbox.braintreegateway.com → Account → My User → API Keys
# Format: sandbox_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx (sandbox)
#      or production_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx (production)
# Used as fallback authorization when no server-generated client_token is available.
VITE_BRAINTREE_TOKENIZATION_KEY=your_braintree_tokenization_key_here

# ── Authorize.net (page 5) ────────────────────────────────────────────────────
# API Login ID and Client Key from https://sandbox.authorize.net → Account → API Credentials
# VITE_AUTHORIZENET_SANDBOX=true uses https://jstest.authorize.net/v1/Accept.js (sandbox)
# VITE_AUTHORIZENET_SANDBOX=false (or unset) uses https://js.authorize.net/v1/Accept.js (production)
VITE_AUTHORIZENET_API_LOGIN_ID=your_api_login_id_here
VITE_AUTHORIZENET_CLIENT_KEY=your_client_key_here
VITE_AUTHORIZENET_SANDBOX=true

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_DISABLE_PAGE1=false
VITE_DISABLE_PAGE2=false
VITE_DISABLE_PAGE3=false
VITE_DISABLE_PAGE4=false
VITE_DISABLE_PAGE5=false

# ── Google Maps (page 2) ──────────────────────────────────────────────────────
VITE_GOOGLE_API_KEY=your_google_api_key_here

# ── Misc ──────────────────────────────────────────────────────────────────────
VITE_TRANSLATION_ENDPOINT=https://your-server.example.com/api/translate