{
  "name": "@lfz/form-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laserfiche/lfz-form-builder.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:types": "npm run build --workspace=packages/types",
    "build:core": "npm run build --workspace=packages/core",
    "build:examples": "npm run build:core -- -- --logLevel silent && npm run build --workspace=packages/examples",
    "build": "tsc -b",
    "dev": "npm run dev --workspace=packages/examples",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run typecheck --workspace=packages/core && npm test --workspace=packages/core",
    "test:coverage": "npm run test:coverage --workspace=packages/core",
    "release": "scripts/release.sh",
    "docs:generate": "typedoc",
    "docs:dev": "vitepress dev",
    "docs:build": "npm run docs:generate && vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/eslint__js": "^8.42.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript-eslint": "^7.16.1",
    "vitepress": "^1.6.4"
  }
}
