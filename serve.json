{
  "public": "./dist",
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Private-Network",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*" 
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, PUT, POST, DELETE, OPTIONS"
        }
      ]
    }
  ]
}