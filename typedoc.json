{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/types/",
    "packages/core/"
  ],
  "out": "docs/api",
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/vitest.config.ts",
    "**/vite.config.lib.ts",
    "**/tsconfig.*.json"
  ],
  "excludePrivate": true,
}