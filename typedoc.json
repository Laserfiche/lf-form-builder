{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/*",
  ],
  "out": "./docs/api",
  "docsRoot": "./docs",
  "exclude": [
    "**/node_modules/**",
    "**/__tests__/**",
    "**/vitest.config.ts",
    "**/vite.config.lib.ts"
  ],
  "excludePrivate": true,
}